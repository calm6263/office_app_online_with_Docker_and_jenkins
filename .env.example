# ========================================
# إعدادات التطبيق - انسخ هذا الملف إلى .env وعدّل القيم
# ========================================

# مفتاح سري للجلسات (استخدم: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_chars

# قاعدة البيانات
DATABASE_URL=postgresql://office_user:strong_password_here@db:5432/office_services

# PostgreSQL
POSTGRES_USER=office_user
POSTGRES_PASSWORD=strong_password_here
POSTGRES_DB=office_services

# بيئة التشغيل (production أو development)
FLASK_ENV=production
FLASK_DEBUG=0

# Gunicorn
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# حد حجم الملف المرفوع (بالميجابايت)
MAX_UPLOAD_MB=16

# مدة الجلسة (بالدقائق)
SESSION_LIFETIME_MINUTES=60

# Slack (اختياري - للإشعارات في Jenkins)
SLACK_WEBHOOK_URL=

# مفتاح API Jenkins (اختياري)
JENKINS_API_TOKEN=
